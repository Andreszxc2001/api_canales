# ============================================================
# api_canales - variables de entorno
# Copia este archivo a .env y llena los valores
# ============================================================

# --- Mistral (https://console.mistral.ai/) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_URL=https://api.mistral.ai/v1/chat/completions
# MISTRAL_TEMPERATURA=0.3
# MISTRAL_MAX_TOKENS=4000
# MISTRAL_PROMPT=Escribe aqui tu prompt de sistema personalizado...

# --- Supabase (https://supabase.com/dashboard) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage para las imagenes (se crea con supabase.sql)
SUPABASE_BUCKET=imagenes_posts
# Respaldo de la sesión de WhatsApp en Storage (sobrevive reinicios de Render)
RESPALDO_SESION=true
RESPALDO_SESION_MINUTOS=15
# Reproceso de filas ya guardadas sin texto_ia (al iniciar y vía /reprocesar)
REPROCESAR_AL_INICIAR=true
REPROCESO_LOTE=200
# Imágenes: convertir a WebP antes de subirlas a Storage
CONVERTIR_WEBP=true
WEBP_CALIDAD=80
# Segundos de espera para el "ready" de WhatsApp (Render free = 0.1 CPU arranca lento)
ESPERA_LISTO_SEGUNDOS=45

# --- Canales a monitorear (IDs @newsletter, links o códigos, separados por coma) ---
CANALES=123456789@newsletter,https://whatsapp.com/channel/AbCdEfGhIjKlMnOp

# --- Operación ---
INTERVALO_MINUTOS=2
LIMITE_MENSAJES=50
PRIMERAS_HORAS=24
OCR_IDIOMA=spa
OCR_IDLE_MINUTOS=10
# Pausa entre publicaciones para no chocar con el límite de Mistral (free: ~1 req/s)
PAUSA_PUBLICACIONES_MS=1500
# PUERTO=3000        (en Render usa la variable PORT que ellos inyectan)
# DATA_DIR=./data
# LOG_NIVEL=info
# Código de vinculación (opcional): número con código de país, solo dígitos (ej. 573001234567).
# Si está vacío se usa solo el QR.
WHATSAPP_TELEFONO=

# Timeout de arranque de Chromium en segundos (Render free tarda más de 30s).
NAVEGADOR_TIMEOUT_SEGUNDOS=120
# --- WhatsApp via Evolution API (opcional; si EVOLUTION_URL esta definida NO se usa Chromium) ---
EVOLUTION_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCIA=
